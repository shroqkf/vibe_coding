# 한국투자증권(KIS) Open API 인증 정보 템플릿
# 실제 값은 .env 파일에 입력하세요. .env는 git에 커밋되지 않습니다.

KIS_APP_KEY=
KIS_APP_SECRET=

# (선택) 접속 도메인. 지정하지 않으면 실전투자 도메인이 기본값으로 사용됩니다.
# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
# 이 앱은 모의투자 전용입니다 — 반드시 모의투자 도메인을 사용하세요.
KIS_BASE_URL=

# 모의투자 계좌번호. "계좌번호-상품코드" 형식 (예: 12345678-01).
# 잔고 조회/주문 기능에 필요합니다.
KIS_ACCOUNT=
